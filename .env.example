# Bu dosyaya gercek deger yazmayin; degerleri isletim sistemi ortaminda saklayin.
# Varsayilan teslimat direct'tir: sahip ve onayli aboneler mesaji ayri ozel
# sohbetlerde alir, birbirini goremez. Kanal kurmak gerekmez.
CRYPTO_TELEGRAM_BOT_TOKEN=
CRYPTO_TELEGRAM_OWNER_ID=
CRYPTO_TELEGRAM_DELIVERY_MODE=direct
# Yalniz eski kanal yayinini acikca kullanmak isterseniz mode=channel yapin ve
# kanal kimligini girin. Direct modda bu deger kullanilmaz.
CRYPTO_TELEGRAM_CHAT_ID=
CRYPTO_MODEL_RESEARCH_INTERVAL_HOURS=168

# --- Deneysel geniş-evren scalp gözlemi ---
# Varsayılan kapalıdır. Açıldığında trade1'in sürümlü 30+59 statik evreninde
# yalnız 5m F1/F2/F3 kurulumlarını tarar. Bunlar tarihsel kapıyı geçmemiştir;
# mesajlar "SCALP GÖZLEM" olur, hiçbir zaman İŞLEM ADAYI olmaz.
CRYPTO_SCALP_OBSERVATION=false
# Mesaj başına en güçlü kaç kurulum (1..10).
CRYPTO_SCALP_TOP_K=5
# Yeterli ileri veri yokken kullanılan geçici ham-güç eşiği.
CRYPTO_SCALP_MIN_ALERT_SCORE=2.5
# Yeterli veri oluşunca aile/rejim içi yüzdelik ve gerçekleşmiş net kalite kapısı.
CRYPTO_SCALP_MIN_QUALITY_PERCENTILE=0.60
CRYPTO_SCALP_MIN_DIRECTION_PROBABILITY=0.55
CRYPTO_SCALP_MIN_EXPECTED_NET_BPS=0.0
CRYPTO_SCALP_MIN_CALIBRATION_SAMPLES=30
# Dinamik scalp TP/SL ilk-dokunuş ufku; %2/%3 ayrıca uzun momentum kilometre taşıdır.
CRYPTO_SCALP_BRACKET_HORIZON_MINUTES=60
CRYPTO_SCALP_MILESTONE_HORIZON_HOURS=24
# İlk/yerel 5m önbellek kapsamı (2..30 gün; varsayılan 3).
CRYPTO_SCALP_CACHE_DAYS=3
# Boş = 89 sembol. Güvenli küçük deneme: BTCUSDT,ETHUSDT,SOLUSDT
CRYPTO_SCALP_SYMBOLS=
# Telegram için evrenin en az bu oranı taze olmalı (0.50..1.00).
CRYPTO_SCALP_MINIMUM_COVERAGE=0.90
# Canli yaklasik maliyet = max(tarihsel 12 bps,
# 2*taker + anlik spread + 2*tek-yon kayma). Hesabin gercek komisyonunu yazin.
CRYPTO_SCALP_TAKER_FEE_BPS=5.0
CRYPTO_SCALP_SLIPPAGE_BPS_PER_SIDE=1.0
# Bu spread asilirsa coklu teyit olsa bile KURULUM'a cikmaz, RADAR kalir.
CRYPTO_SCALP_MAXIMUM_SPREAD_BPS=8.0
# 48 saatlik trendinin ustundeki evren orani; boga rejimi alt siniri.
CRYPTO_SCALP_BULL_BREADTH=0.60
