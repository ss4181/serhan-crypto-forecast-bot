# /etc/crypto-forecaster.env
# Gercek degerleri yalnizca sunucuda, 0600 izinle tutun. Bu dosyayi repoya
# gercek degerlerle commit etmeyin.

# --- Telegram ---
CRYPTO_TELEGRAM_BOT_TOKEN=
CRYPTO_TELEGRAM_CHAT_ID=
# Bota /durum, /performans sorabilecek sahibin sayisal Telegram kimligi.
CRYPTO_TELEGRAM_OWNER_ID=

# --- Rol ---
# Bu makine tek gonderici olmalidir. Ayni anda ikinci bir kopya "primary"
# calisirsa her uyari iki kez gider ve Telegram es zamanli getUpdates
# cagrilarini 409 ile reddeder. GitHub Actions kopyasi standby birakilmalidir.
CRYPTO_BOT_ROLE=primary

# --- Piyasa ve semboller ---
# Varsayilan: surekli vadeli sozlesme (islem yapilan enstruman). Spot icin
# CRYPTO_MARKET=spot. Onbellek dosya adi piyasayi tasir, ikisi karismaz.
CRYPTO_MARKET=
# Virgulle ayrilmis liste; bos birakilirsa BTCUSDT,ETHUSDT.
CRYPTO_SYMBOLS=

# --- Gorunum ---
# Mesajlardaki saatler bu dilimde yazilir. Bos birakilirsa Europe/Istanbul.
CRYPTO_DISPLAY_TIMEZONE=

# --- Panel (istege bagli) ---
PROJECT_HUB_INGEST_URL=
PROJECT_HUB_INGEST_TOKEN=
OAI_SITES_BYPASS_TOKEN=
