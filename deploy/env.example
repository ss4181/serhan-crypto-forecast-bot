# /etc/crypto-forecaster.env
# Gercek degerleri yalnizca sunucuda, 0600 izinle tutun. Bu dosyayi repoya
# gercek degerlerle commit etmeyin.

# --- Telegram ---
CRYPTO_TELEGRAM_BOT_TOKEN=
# Bildirimler varsayilan olarak sahip ve onayli abonelere ayri ozel mesajla
# gider. Uyeler birbirini goremez; uyelik kararlarini yalniz sahip verir.
CRYPTO_TELEGRAM_OWNER_ID=
CRYPTO_TELEGRAM_DELIVERY_MODE=direct
# Sadece eski kanal yayinina donulecekse mode=channel yapilir ve bu alan girilir.
# Direct modda bos kalabilir veya mevcut deger geri donus icin saklanabilir.
CRYPTO_TELEGRAM_CHAT_ID=
CRYPTO_MODEL_RESEARCH_INTERVAL_HOURS=168

# --- Rol ---
# Bu makine tek gonderici olmalidir. Ayni anda ikinci bir kopya "primary"
# calisirsa her uyari iki kez gider ve Telegram es zamanli getUpdates
# cagrilarini 409 ile reddeder. GitHub Actions kopyasi standby birakilmalidir.
CRYPTO_BOT_ROLE=primary

# --- Piyasa ve semboller ---
# Varsayilan: surekli vadeli sozlesme (islem yapilan enstruman). Spot icin
# CRYPTO_MARKET=spot. Onbellek dosya adi piyasayi tasir, ikisi karismaz.
CRYPTO_MARKET=
# Virgulle ayrilmis liste; bos birakilirsa BTCUSDT,ETHUSDT.
CRYPTO_SYMBOLS=

# --- Deneysel geniş-evren scalp gözlemi ---
# Varsayılan KAPALI. True olduğunda trade1'in sürümlü 89-coin manifestini 5m
# futures verisiyle tarar. Yalnız SCALP GÖZLEM özeti üretir; işlem kapısına veya
# BTC/ETH modellerine bağlanmaz.
CRYPTO_SCALP_OBSERVATION=false
CRYPTO_SCALP_TOP_K=5
# Telegram filtresi: yalnızca bu skorun üzerindeki net yönlü KURULUM'lar bildirilir.
CRYPTO_SCALP_MIN_ALERT_SCORE=2.5
CRYPTO_SCALP_CACHE_DAYS=3
# Bos = tum 89; virgulle ayrilmis alt kume de verilebilir.
CRYPTO_SCALP_SYMBOLS=
CRYPTO_SCALP_MINIMUM_COVERAGE=0.90
CRYPTO_SCALP_TAKER_FEE_BPS=5.0
CRYPTO_SCALP_SLIPPAGE_BPS_PER_SIDE=1.0
CRYPTO_SCALP_MAXIMUM_SPREAD_BPS=8.0
CRYPTO_SCALP_BULL_BREADTH=0.60

# --- Gorunum ---
# Mesajlardaki saatler bu dilimde yazilir. Bos birakilirsa Europe/Istanbul.
CRYPTO_DISPLAY_TIMEZONE=

# --- Panel (istege bagli) ---
PROJECT_HUB_INGEST_URL=
PROJECT_HUB_INGEST_TOKEN=
OAI_SITES_BYPASS_TOKEN=
